# Required: Groq API key for LLM inference
GROQ_API_KEY=your_groq_api_key_here

# Total paid LLM provider calls per running Streamlit process (1-20, default 5)
MAX_API_REQUESTS=5
# Set this after applying infra/ to make the quota global and persistent per month.
# DYNAMODB_QUOTA_TABLE=challenge-epam-llm-quota

# Optional model and chunking configuration
GROQ_MODEL=llama-3.1-70b-versatile
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=4

# Optional paths
DATA_DIR=./data/raw
CHROMA_DIR=./chroma_db
