# LLM provider: "groq", or "bedrock" (Bedrock chain, then Groq if a key is set).
# The AWS Emulator has no language model, so use groq with the emulator.
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# --- AWS Emulator (Cognito + DynamoDB) -------------------------------------------
# Run `source scripts/emulator_env.sh` in the shell that starts the app: it sets
# AWS_ENDPOINT_URL, the emulator credentials file and its CA bundle.
# The emulator starts empty, so let the app create its tables and user pool.
AWS_AUTO_CREATE_RESOURCES=true
# The emulator sends no verification e-mail/SMS: confirm new accounts server-side.
COGNITO_AUTO_CONFIRM=true
# Optional: use an existing pool instead of looking it up / creating it by name.
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_USER_POOL_NAME=challenge-epam-llm-users

# Sessions (DynamoDB) and the LLM token budget of each session
SESSIONS_TABLE=challenge-epam-llm-sessions
SESSION_TOKEN_LIMIT=10000
SESSION_TTL_SECONDS=3600

# Per-IP account-creation limit (fixed window), against mass sign-ups
RATE_LIMIT_TABLE=challenge-epam-llm-rate-limits
SIGNUP_LIMIT_PER_IP=3
SIGNUP_WINDOW_SECONDS=86400
# Reverse proxies in front of the app whose X-Forwarded-For is trusted (0 = none)
TRUSTED_PROXY_HOPS=0

# Total paid LLM provider calls per running Streamlit process (1-20, default 5)
MAX_API_REQUESTS=5
# Set this after applying infra/ to make the quota global and persistent per month.
# DYNAMODB_QUOTA_TABLE=challenge-epam-llm-quota

# Optional model and chunking configuration
GROQ_MODEL=llama-3.1-70b-versatile
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=4

# Optional paths
DATA_DIR=./data/raw
CHROMA_DIR=./chroma_db
