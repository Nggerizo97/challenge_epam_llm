# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables and secrets
.env
.env.*
!.env.example

# Build and packaging
build/
dist/
*.egg-info/
.eggs/

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Jupyter and local notebooks
.ipynb_checkpoints/

# Logs and temporary files
*.log
*.tmp
*.bak

# OS files
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
.idea/

# Local vector database and generated data
chroma_db/
data/processed/

# Ignore raw downloaded datasets (> 100 MB)
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.xls
data/raw/*.pdf
!data/raw/.gitkeep
!data/raw/automated_scraper_manifest.json
